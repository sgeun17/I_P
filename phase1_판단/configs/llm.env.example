# Phase 1 판단 LLM — Ollama / OpenAI-compatible API
# 실제 .env 로더를 추가한 것이 아니라, 실행 환경에 설정할 값의 예시다.
# 비밀값이 생기면 실제 값은 Git에 커밋하지 않는다.

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_ENDPOINT=/chat/completions

# 1차 baseline. 실제 장비/골든셋 결과에 따라 14B 후보와 비교 후 변경 가능.
LLM_MODEL=qwen3:8b-q4_K_M

LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_STREAM=false
LLM_THINKING=false
LLM_THINKING_EFFORT=medium

# 기존 RetryPolicy의 현재 기본값과 맞춘 초기값. 실측 후 조정 가능.
LLM_TIMEOUT_SECONDS=60

# Context Budget Guard는 정확한 tokenizer 연결 후 활성화한다.
# Qwen3 8B/14B Ollama 모델 메타데이터의 context length는 현재 40960이지만,
# 실제 runtime/tokenizer 확인 전에는 비워 두는 것을 권장한다.
# LLM_CONTEXT_WINDOW=40960
LLM_CONTEXT_SAFETY_MARGIN=512

# 로컬 Ollama raw HTTP 호출은 기본적으로 인증이 필요하지 않는다.
# 프록시/별도 배포에서 필요한 경우에만 설정한다.
# LLM_API_KEY=
