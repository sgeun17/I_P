# Phase 2 판단 LLM runtime
# 확정 서빙 환경: Ollama + OpenAI-compatible API + localhost + Qwen3 series

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_ENDPOINT=/chat/completions

# 장비 사양에 맞는 실제 Ollama tag를 사용한다.
# 예: qwen3:8b, qwen3:14b 등. `ollama list`의 NAME을 그대로 넣는다.
LLM_MODEL=qwen3:8b

# 구조화 판정 baseline
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_STREAM=false
LLM_THINKING=false
LLM_THINKING_EFFORT=medium
LLM_TIMEOUT_SECONDS=60

# 정확한 tokenizer/counter를 연결하기 전에는 비워 둔다.
# LLM_CONTEXT_WINDOW=40960
LLM_CONTEXT_SAFETY_MARGIN=512

# localhost Ollama는 기본적으로 별도 API key를 사용하지 않는다.
# LLM_API_KEY=
